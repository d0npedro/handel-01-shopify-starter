# Runtime mode: keep "demo" until every go-live check passes.
SHOP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shopify Headless channel (server only)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Public merchant data required by the legal pages
LEGAL_NAME=
LEGAL_OWNER=
LEGAL_STREET=
LEGAL_POSTCODE=
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_REGISTER=
LEGAL_REGISTER_NUMBER=
LEGAL_VAT_ID=
LEGAL_LUCID_NUMBER=

# Transactional email for the online revocation function
RESEND_API_KEY=
REVOCATION_EMAIL_FROM=widerruf@your-domain.de

# Optional store identity
NEXT_PUBLIC_STORE_NAME=HANDEL/01
NEXT_PUBLIC_STORE_TAGLINE=Ein System. Jede Idee.
